{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "topic_ideas.v1"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^art_[0-9a-f]{32}$"
    },
    "source_hash": {
      "type": "string",
      "minLength": 1,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^prj_[0-9a-f]{32}$"
    },
    "ideas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "idea_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]{1,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "hook": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "idea_id",
          "title",
          "hook",
          "summary"
        ]
      },
      "minItems": 1,
      "maxItems": 10
    }
  },
  "required": [
    "schema_version",
    "artifact_id",
    "source_hash",
    "project_id",
    "ideas"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-2d-animation-studio.local/contracts/schemas/topic_ideas.schema.json",
  "title": "topic_ideas.v1"
}
