{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "script.v1"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^art_[0-9a-f]{32}$"
    },
    "source_hash": {
      "type": "string",
      "minLength": 1,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^prj_[0-9a-f]{32}$"
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "section_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]{1,63}$"
          },
          "narration_text": {
            "type": "string",
            "minLength": 1
          },
          "story_intent": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "section_id",
          "narration_text",
          "story_intent"
        ]
      },
      "minItems": 1,
      "maxItems": 30
    },
    "full_narration": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "artifact_id",
    "source_hash",
    "project_id",
    "sections",
    "full_narration"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-2d-animation-studio.local/contracts/schemas/script.schema.json",
  "title": "script.v1"
}
